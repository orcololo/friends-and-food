# ============================================
# Friends & Food - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!

# ============================================
# DATABASE
# ============================================
# MongoDB connection string
# Get this from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/friends-and-food?retryWrites=true&w=majority

# Alternative for local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/friends-and-food

# ============================================
# AUTHENTICATION
# ============================================
# JWT Secret for signing tokens
# Generate a secure random string (minimum 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars

# JWT Token Expiration (optional)
# Default: 7d (7 days)
JWT_EXPIRES_IN=7d

# ============================================
# BLOB STORAGE (Vercel Blob)
# ============================================
# Vercel Blob Storage for image uploads
# Get this from: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# APPLICATION
# ============================================
# Next.js Public URL
# Use your production domain or localhost for development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Base URL (for client-side API calls)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# WebSocket/Socket.io URL
# Use the same as APP_URL in development
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ============================================
# OPTIONAL: EMAIL SERVICE (for notifications)
# ============================================
# If you want to send email notifications
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ============================================
# OPTIONAL: MAP SERVICES
# ============================================
# OpenStreetMap doesn't require API key
# But if you switch to other map providers:
# NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# ============================================
# DEVELOPMENT
# ============================================
# Set to 'development' or 'production'
NODE_ENV=development

# Enable debug logging (optional)
# DEBUG=true

# ============================================
# SECURITY (Production Only)
# ============================================
# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# ============================================
# NOTES
# ============================================
# 1. After copying this file to .env.local, restart your dev server
# 2. Never commit .env.local to version control
# 3. Use strong, unique values for JWT_SECRET in production
# 4. For production, use environment variables in your hosting platform
# 5. Keep your MongoDB connection string secure
